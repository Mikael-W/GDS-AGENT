# Réglages du web en local (copier en apps/web/.env.local). La prod lit le coffre.
ENVIRONNEMENT=dev
# Valeur de développement, refusée en production.
AUTH_SECRET=secret-de-developpement-a-ne-jamais-utiliser-en-prod
# Keycloak local d'aisisters-apps, realm du client, client confidentiel.
AUTH_KEYCLOAK_ISSUER=http://localhost:8081/realms/client-gds
AUTH_KEYCLOAK_ID=gds-web
AUTH_KEYCLOAK_SECRET=
AUTH_URL=http://localhost:3000
DATABASE_URL=postgres://app:app@127.0.0.1:5440/app
SENTRY_DSN=
# Identifiants AWS : profil local (AWS_PROFILE) ou variables standard.
AWS_REGION=eu-west-3
