{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["GIT_SHA"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "EXIGER_BASE"]
    },
    "contrats": {
      "cache": false,
      "passThroughEnv": [
        "KEYCLOAK_URL",
        "KEYCLOAK_REALM",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_REGION",
        "LLM_CLE"
      ]
    }
  }
}
